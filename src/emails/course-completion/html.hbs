<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Course Completed</title>
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@700,500,400&display=swap" rel="stylesheet">
</head>
<body style="margin: 0; padding: 0; font-family: 'Satoshi', -apple-system, sans-serif; background-color: #f5f5f5;">
    <table role="presentation" style="width: 100%; border-collapse: collapse;">
        <tr>
            <td style="padding: 40px 20px;">
                <table role="presentation" style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                    <tr>
                        <td style="padding: 40px;">
                            <h1 style="margin: 0 0 20px; font-size: 24px; color: #333; font-weight: 700;">Congratulations! 🏆</h1>
                            <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #555;">
                                Hi {{name}},
                            </p>
                            <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #555;">
                                You've completed <strong>{{courseTitle}}</strong>! This is a fantastic achievement and we're proud of your dedication.
                            </p>
                            {{#if certificateUrl}}
                            <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #555;">
                                Your certificate is ready. Download or share it from the link below.
                            </p>
                            <table role="presentation" style="margin: 24px 0;">
                                <tr>
                                    <td style="text-align: center;">
                                        <a href="{{certificateUrl}}" style="display: inline-block; padding: 14px 32px; background-color: #feb307; color: #000; text-decoration: none; border-radius: 6px; font-weight: 700; font-size: 16px;">View Certificate</a>
                                    </td>
                                </tr>
                            </table>
                            {{/if}}
                            <p style="margin: 24px 0 0; font-size: 14px; line-height: 1.6; color: #888;">
                                Keep learning and growing!<br><strong>The Hive Team</strong>
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="background-color: #f9f9f9; padding: 24px 40px; text-align: center; border-top: 1px solid #eee;">
                            <p style="margin: 0; font-size: 12px; color: #888;">© 2026 Hive Inc. All rights reserved.</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
